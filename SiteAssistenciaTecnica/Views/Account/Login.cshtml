@model SiteAssistenciaTecnica.Models.Login

<h2>Login</h2>


<form asp-action="Login" method="post">

    <div>
        <label>Email</label>
        <input asp-for="Email"
               class="form-control" />
    </div>


    <div>
        <label>Senha</label>
        <input asp-for="Password"
               type="password"
               class="form-control" />
    </div>


    <br />

    <button type="submit">
        Entrar
    </button>


    <div asp-validation-summary="All"></div>

</form>