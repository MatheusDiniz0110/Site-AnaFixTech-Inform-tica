@model List<SiteAssistenciaTecnica.Models.Service>
@{
    ViewData["Title"] = "Nossos Serviços";

    // Gera as abas de filtro a partir das categorias que existem no banco
    var categorias = Model.Select(s => s.Class).Distinct().OrderBy(c => c).ToList();

    string BadgeClass(string categoria) => categoria switch
    {
        "Software" => "badge-software",
        "Dados" => "badge-dados",
        "Hardware" => "badge-hardware",
        "Redes" => "badge-redes",
        _ => "badge-outros"
    };
}

<div class="servicos-page">
    <div class="servicos-header">
        <span class="servicos-eyebrow">CATÁLOGO</span>
        <h1 class="servicos-title">Nossos Serviços</h1>
        <p class="servicos-subtitle">
            Confira todos os serviços que oferecemos. Selecione o que você precisa e faça sua solicitação.
        </p>
    </div>

    <div class="servicos-tabs" id="filtro-tabs">
        <button type="button" class="tab-btn active" data-filtro="Todos">Todos</button>
        @foreach (var categoria in categorias)
        {
            <button type="button" class="tab-btn" data-filtro="@categoria">@categoria</button>
        }
    </div>

    @if (!Model.Any())
    {
        <p class="text-center text-muted mt-5">Nenhum serviço cadastrado no momento.</p>
    }
    else
    {
        <div class="servicos-grid" id="servicos-grid">
            @foreach (var servico in Model)
            {
                <div class="servico-card" data-categoria="@servico.Class">
                    <div class="servico-card-top">
                        <div class="servico-icone">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </div>
                        <span class="badge-categoria @BadgeClass(servico.Class)">@servico.Class</span>
                    </div>

                    <h3 class="servico-nome">@servico.Title</h3>
                    <p class="servico-descricao">@servico.Description</p>

                    <p class="servico-preco">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" x2="12" y1="1" y2="23" />
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                        </svg>
                        R$ @servico.Price.ToString()
                    </p>

                    <a asp-controller="ServiceRequest" asp-action="Index" asp-route-servicoId="@servico.Id" class="btn-solicitar">
                        Solicitar
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14" />
                            <path d="m12 5 7 7-7 7" />
                        </svg>
                    </a>
                </div>
            }
        </div>
    }
</div>

<style>
    .servicos-page { background: #05070f; color: #e5e7eb; padding: 64px 24px 96px; }
    .servicos-header { text-align: center; max-width: 640px; margin: 0 auto 40px; }
    .servicos-eyebrow { color: #60a5fa; font-weight: 600; letter-spacing: .12em; font-size: .8rem; }
    .servicos-title { font-size: 2.75rem; font-weight: 800; color: #fff; margin: 12px 0 16px; }
    .servicos-subtitle { color: #94a3b8; font-size: 1.05rem; line-height: 1.6; }

    .servicos-tabs { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin: 0 auto 48px; }
    .tab-btn {
        background: #10141f; border: 1px solid #1f2937; color: #94a3b8;
        padding: 8px 18px; border-radius: 999px; font-size: .85rem; font-weight: 500;
        cursor: pointer; transition: all .15s ease;
    }
    .tab-btn:hover { color: #fff; border-color: #334155; }
    .tab-btn.active { background: #2563eb; border-color: #2563eb; color: #fff; }

    .servicos-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px; max-width: 1200px; margin: 0 auto;
    }

    .servico-card {
        background: #0b0f1a; border: 1px solid #1f2937; border-radius: 16px;
        padding: 24px; display: flex; flex-direction: column;
    }

    .servico-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }

    .servico-icone {
        width: 44px; height: 44px; border-radius: 12px;
        background: rgba(37, 99, 235, .15); color: #60a5fa;
        display: flex; align-items: center; justify-content: center;
    }

    .badge-categoria { font-size: .72rem; font-weight: 600; padding: 4px 10px; border-radius: 999px; }
    .badge-software { background: rgba(16, 185, 129, .15); color: #34d399; }
    .badge-dados { background: rgba(168, 85, 247, .15); color: #c084fc; }
    .badge-hardware { background: rgba(59, 130, 246, .15); color: #60a5fa; }
    .badge-redes { background: rgba(6, 182, 212, .15); color: #22d3ee; }
    .badge-outros { background: rgba(148, 163, 184, .15); color: #94a3b8; }

    .servico-nome { color: #fff; font-size: 1.15rem; font-weight: 700; margin-bottom: 8px; }
    .servico-descricao { color: #94a3b8; font-size: .9rem; line-height: 1.55; flex-grow: 1; margin-bottom: 16px; }

    .servico-preco { display: flex; align-items: center; gap: 6px; color: #34d399; font-weight: 600; margin-bottom: 16px; }

    .btn-solicitar {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        background: #1e293b; color: #fff; text-decoration: none;
        font-weight: 600; font-size: .9rem; padding: 10px; border-radius: 10px;
        transition: background .15s ease;
    }
    .btn-solicitar:hover { background: #334155; color: #fff; }
</style>

@section Scripts {
    <script>
        (function () {
            const botoes = document.querySelectorAll('#filtro-tabs .tab-btn');
            const cards = document.querySelectorAll('#servicos-grid .servico-card');

            botoes.forEach(function (botao) {
                botao.addEventListener('click', function () {
                    botoes.forEach(function (b) { b.classList.remove('active'); });
                    botao.classList.add('active');

                    const filtro = botao.dataset.filtro;
                    cards.forEach(function (card) {
                        const mostrar = filtro === 'Todos' || card.dataset.categoria === filtro;
                        card.style.display = mostrar ? '' : 'none';
                    });
                });
            });
        })();
    </script>
}